{
  "manifest_version": 3,
  "name": "SongDrop",
  "version": "0.5.0",
  "description": "Send supported YouTube audio to the local SongDrop service.",
  "key": "",
  "minimum_chrome_version": "109",
  "permissions": ["activeTab", "alarms", "nativeMessaging", "notifications", "storage"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Send to SongDrop"
  }
}
